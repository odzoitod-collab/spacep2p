BOT_TOKEN=123456:replace-me
ADMIN_IDS=[123456789]
# operators of Bybit-order deals (give requisites of the order, confirm payment); empty = ADMIN_IDS
OPERATOR_IDS=
DATABASE_URL=postgresql+asyncpg://p2p:p2p@localhost:5432/p2p
# USDT BEP-20 (BNB Smart Chain): the bot makes its own BIP-39 seed on the first start and stores it encrypted with
# MASTER_SECRET. Set MASTER_SECRET BEFORE that start and never change it: a seed that does not decrypt keeps the desk off.
# Back the seed up with /bsc_key (owners, private chat). Empty MASTER_SECRET and BSC_MNEMONIC = BEP-20 is off.
MASTER_SECRET=
# own seed instead of the stored one (12/24 words), optional
BSC_MNEMONIC=
# the hot wallet expected (0x…, MetaMask Account 1): another derived one keeps the desk off, optional
BSC_WALLET_ADDRESS=
# own (paid) RPC nodes, comma separated: tried first, the public ones stay as fallback
BSC_RPC_URLS=
# optional cold wallet: the hot wallet's USDT over BSC_HOT_MAX_USDT go there by themselves (no key on the server)
BSC_COLD_ADDRESS=
BSC_HOT_MAX_USDT=
# chat for admin logs (optional, defaults to ADMIN_IDS)
LOG_CHAT_ID=
# premium | plain | none — custom emoji need Telegram Premium on the bot owner's account
EMOJI_MODE=premium
# LOG_CHAT_ID as a group with topics: the bot creates a topic per kind of log itself (needs "Manage topics").
# LOG_THREAD_ID is only a fallback topic for a forum where the bot may not create topics (optional)
LOG_THREAD_ID=
# banner on top of every screen: picture or silent mp4 animation, relative to the project root (empty = none)
BANNER_PATH=images/banner.mp4
# Strait Pay API for services (docs/API.md). Listen locally; expose via HTTPS proxy on your domain.
API_ENABLED=false
API_HOST=127.0.0.1
API_PORT=8080
# e.g. https://api.your-domain.com — shown to API clients
API_PUBLIC_URL=
