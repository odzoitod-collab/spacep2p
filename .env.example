BOT_TOKEN=123456:replace-me
ADMIN_IDS=[123456789]
# operators of Bybit-order deals (give requisites of the order, confirm payment); empty = ADMIN_IDS
OPERATOR_IDS=
DATABASE_URL=postgresql+asyncpg://p2p:p2p@localhost:5432/p2p
# USDT on TON: the key to every wallet of the bot (hot wallet, users' deposit and debt addresses).
# Create: python -m bot.services.ton seed. Keep an offline copy, never share: whoever has it can move the funds.
TON_SEED=
# toncenter.com key from @tonapibot (10 req/s instead of 1); an owner can also set it in the admin panel
TON_API_KEY=
TON_TESTNET=false
# USD₮ jetton master (mainnet default); set the testnet one together with TON_TESTNET=true
TON_USDT_MASTER=
# chat for admin logs (optional, defaults to ADMIN_IDS)
LOG_CHAT_ID=
# premium | plain | none — custom emoji need Telegram Premium on the bot owner's account
EMOJI_MODE=premium
# LOG_CHAT_ID as a group with topics: the bot creates a topic per kind of log itself (needs "Manage topics").
# LOG_THREAD_ID is only a fallback topic for a forum where the bot may not create topics (optional)
LOG_THREAD_ID=
# banner on top of every screen: picture or silent mp4 animation, relative to the project root (empty = none)
BANNER_PATH=images/banner.mp4
# Strait Pay API for services (docs/API.md). Listen locally; expose via HTTPS proxy on your domain.
API_ENABLED=false
API_HOST=127.0.0.1
API_PORT=8080
# e.g. https://api.your-domain.com — shown to API clients
API_PUBLIC_URL=
